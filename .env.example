NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
DATA_DRIVER=memory
DATABASE_URL=postgres://sankeng:sankeng@localhost:5432/sankeng
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8787
# 对象存储驱动：local（本地磁盘，默认）| oss（阿里云 OSS）
STORAGE_DRIVER=local
UPLOAD_DIR=./var/uploads
# OSS 配置（STORAGE_DRIVER=oss 时必填）
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=10485760
AI_PROVIDER=safe_mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
